# =============================================================================
# bongCunManager — environment template
#
# Vite SPA: EVERY variable here is inlined into the client bundle at build time
# and is therefore PUBLIC and readable by anyone who loads the site.
# Never put a server-side secret (e.g. the Supabase service_role key) in this
# file or in .env. Only names prefixed with VITE_ are exposed to the application.
#
# Copy to .env and fill in. All of them are read in one place: src/config/env.ts.
# Setup steps: docs/supabase-setup.md
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — REQUIRED. The app throws at start-up without these.
# Source: Supabase dashboard > Project Settings > API (or the "Connect" dialog).
# Use the PUBLISHABLE key (sb_publishable_...), never the service_role / secret
# key. Data is protected by Row Level Security (supabase/migrations/), not by
# hiding these values.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_key>

# -----------------------------------------------------------------------------
# Internationalization — bundled locales are vi.json and en.json only.
# VITE_SUPPORTED_LOCALES is REQUIRED (the app throws at start-up without it).
# -----------------------------------------------------------------------------
VITE_SUPPORTED_LOCALES=vi,en
VITE_DEFAULT_LOCALE=vi
VITE_FALLBACK_LOCALE=en

# -----------------------------------------------------------------------------
# Router — createWebHistory base path. Leave empty when serving from the domain
# root, which is what vercel.json does.
# -----------------------------------------------------------------------------
VITE_PUBLIC_PATH=

# -----------------------------------------------------------------------------
# GHN shipping (Giao Hang Nhanh) — OPTIONAL: the app starts and every
# non-shipping flow works without these.
# Get credentials at https://khachhang.ghn.vn (Developer / API settings).
#
# !! SECURITY: these are inlined into the browser bundle, so they are readable by
# !! anyone. A GHN token is an account credential, which makes calling GHN
# !! straight from the client an inherent flaw. A server-side proxy is the real
# !! fix. Also note src/services/shipment.service.ts still hardcodes a ShopId.
#
# VITE_APP_GHN_TOKEN is used as an `if (token)` gate in location.service.ts: when
# empty, the province/district/ward address dropdowns return nothing.
# -----------------------------------------------------------------------------
VITE_APP_GHN_TOKEN=<ghn-api-token>

# GHN service id for light goods, sent as service_id in the leadtime request.
# Fetch valid ids for your shop from GHN's available-services endpoint.
VITE_APP_GHN_SERVICE_ID_TYPE_LIGHT_GOODS=<ghn-light-goods-service-id>

# -----------------------------------------------------------------------------
# Dev scripts only — scripts/seed-test-accounts.mjs (npm run seed:test-accounts).
# Deliberately NOT prefixed with VITE_, so Vite never bundles them into the browser.
# The service-role key bypasses Row Level Security: keep it out of source control,
# out of client code and out of production tooling that does not need it.
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
ALLOW_TEST_ACCOUNTS=false
TEST_ACCOUNT_EMAIL_DOMAIN=bongcun.test
TEST_ACCOUNT_PASSWORD=<choose-a-strong-test-password>
