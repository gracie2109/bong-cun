# =============================================================================
# bongCunManager — environment template (Nuxt 4)
#
# NUXT_PUBLIC_* values are sent to the browser and are therefore PUBLIC.
# Every other NUXT_* value stays on the server (runtimeConfig, nuxt.config.ts).
# Never put a server-side secret in a NUXT_PUBLIC_* variable.
#
# Copy to .env and fill in. Setup steps: docs/supabase-setup.md
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — REQUIRED (read by @nuxtjs/supabase).
# Source: Supabase dashboard > Project Settings > API (or the "Connect" dialog).
# Use the PUBLISHABLE key (sb_publishable_...), never the service_role / secret
# key. Data is protected by Row Level Security (supabase/migrations/), not by
# hiding these values.
# -----------------------------------------------------------------------------
NUXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=<sb_publishable_key>

# -----------------------------------------------------------------------------
# Internationalization: locales (vi, en), the default (vi) and the cookie that
# remembers the choice (user-locale) are configured in nuxt.config.ts.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# GHN shipping (Giao Hang Nhanh) — OPTIONAL: the app starts and every
# non-shipping flow works without these. SERVER-ONLY: the browser calls
# /api/ghn/* (server/api/ghn) and never sees these values.
# Get credentials at https://khachhang.ghn.vn (Developer / API settings).
# Without a token the address dropdowns stay empty and /api/ghn/* answers 503.
# -----------------------------------------------------------------------------
NUXT_GHN_TOKEN=<ghn-api-token>
NUXT_GHN_SHOP_ID=<ghn-shop-id>

# GHN service id for light goods, sent as service_id in the leadtime request.
# Fetch valid ids for your shop from GHN's available-services endpoint.
NUXT_GHN_LIGHT_GOODS_SERVICE_ID=<ghn-light-goods-service-id>

# -----------------------------------------------------------------------------
# Dev scripts only — scripts/seed-test-accounts.mjs (npm run seed:test-accounts).
# Not read by the app at all (and not NUXT_PUBLIC_*), so never sent to the browser.
# The service-role key bypasses Row Level Security: keep it out of source control,
# out of client code and out of production tooling that does not need it.
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
ALLOW_TEST_ACCOUNTS=false
TEST_ACCOUNT_EMAIL_DOMAIN=bongcun.test
TEST_ACCOUNT_PASSWORD=<choose-a-strong-test-password>
