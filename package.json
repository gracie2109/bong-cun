{
  "name": "bongcun",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @bongcun/web",
    "build": "npm run build -w @bongcun/web",
    "preview": "npm run preview -w @bongcun/web",
    "generate:mobile": "npm run generate:mobile -w @bongcun/web",
    "type-check": "npm run type-check -w @bongcun/core -w @bongcun/supabase -w @bongcun/web",
    "deps:check": "npm run deps:check -w @bongcun/web && depcruise packages --config packages/.dependency-cruiser.cjs --output-type err",
    "test": "npm run test -w @bongcun/web",
    "seed:test-accounts": "npm run seed:test-accounts -w @bongcun/web",
    "db:start": "npx -y supabase@2.121.0 db start",
    "db:test": "npx -y supabase@2.121.0 test db",
    "db:schema": "npx -y supabase@2.121.0 db dump --local --schema public -f supabase/schema.sql",
    "db:stop": "npx -y supabase@2.121.0 stop",
    "test:db": "npm run test:db -w @bongcun/web",
    "mobile:apk": "npm run generate:mobile && npm run sync -w @bongcun/mobile && npm run apk -w @bongcun/mobile",
    "mobile:check": "npm run check:versions -w @bongcun/mobile"
  }
}
