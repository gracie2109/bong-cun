{
  "name": "beer-sys",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "generate": "nuxt generate",
    "type-check": "nuxt typecheck",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs --output-type err",
    "test": "vitest run",
    "postinstall": "nuxt prepare",
    "seed:test-accounts": "node --env-file=.env scripts/seed-test-accounts.mjs",
    "db:start": "npx -y supabase@2.121.0 db start",
    "db:test": "npx -y supabase@2.121.0 test db",
    "db:schema": "npx -y supabase@2.121.0 db dump --local --schema public -f supabase/schema.sql",
    "db:stop": "npx -y supabase@2.121.0 stop"
  },
  "dependencies": {
    "@internationalized/date": "^3.5.6",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/supabase": "^2.0.10",
    "@pinia/nuxt": "^1.0.2",
    "@radix-icons/vue": "^1.0.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/vue-query": "^5.104.1",
    "@tanstack/vue-table": "^8.20.5",
    "@vee-validate/zod": "^4.13.2",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.0.0-beta.1",
    "lodash-es": "^4.17.21",
    "lucide-vue-next": "^0.427.0",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "read-excel-file": "^9.3.12",
    "reka-ui": "^2.2.0",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7",
    "vee-validate": "^4.13.2",
    "vue": "^3.4.29",
    "vue-multiselect": "^3.1.0",
    "vue-router": "^5.3.1",
    "vue-sonner": "^1.1.4",
    "vue-zoomable": "^1.2.3",
    "vue3-carousel": "^0.14.0",
    "write-excel-file": "^4.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@iconify-json/radix-icons": "^1.2.0",
    "@iconify/vue": "^4.1.2",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.14.5",
    "autoprefixer": "^10.4.20",
    "dependency-cruiser": "^16.10.4",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.9",
    "typescript": "~5.9",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.12"
  }
}
